    <!-- Onboarding -->
    <string name="onboarding_title">Quick setup</string>
    <string name="onboarding_title_teyes">Quick setup for Teyes</string>
    <string name="onboarding_step_usb">Plug the USB adapter into the car, then tap Start.</string>
    <string name="onboarding_usb_default_hint">In the system dialog, tick “Use by default for this USB device”. Otherwise you will have to confirm access after every sleep.</string>
    <string name="onboarding_step_notifications">Allow notifications so the app can warn you about tire problems.</string>
    <string name="onboarding_step_teyes">Teyes closes background apps when it goes to sleep. Set up TPMS Monitor so it keeps running.</string>
    <string name="onboarding_step_widget">Add TPMS to the home screen with FrontApp for Teyes.</string>
    <string name="onboarding_grant_usb">Start</string>
    <string name="onboarding_open_notifications">Allow notifications</string>
    <string name="onboarding_open_teyes_settings">Open Teyes settings</string>
    <string name="onboarding_autostart_title">Auto start after sleep</string>
    <string name="onboarding_autostart_explanation">Without this, monitoring will not survive the head unit\'s sleep: after you switch the ignition back on, tire pressure stays unmonitored until you open the app yourself. In the Teyes (FYT) settings, enable both options below for TPMS Monitor: firmware versions differ in which one keeps apps alive in sleep.</string>
    <string name="onboarding_teyes_more">Also in the Teyes settings: Battery → No restrictions, and lock TPMS Monitor in recent apps. You can finish these later in Settings.</string>
    <string name="onboarding_open_frontapp">Open FrontApp for Teyes</string>
    <string name="onboarding_next">Continue</string>
    <string name="onboarding_finish">Done</string>
    <string name="onboarding_skip">Skip setup</string>

