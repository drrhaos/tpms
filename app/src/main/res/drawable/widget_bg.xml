<?xml version="1.0" encoding="utf-8"?>
<!-- The app's dark page (DarkPalette.background) so the widget's road melts into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#0B0D10"
        android:startColor="#101318" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#1F242B" />
</shape>
