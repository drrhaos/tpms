<?xml version="1.0" encoding="utf-8"?>
<!-- The app's light page (LightPalette.background) so the widget's road melts into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#F3F4F6"
        android:startColor="#FAFAFB" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#D5D9DF" />
</shape>
